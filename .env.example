# ==========================================
# EXEMPLO DE CONFIGURAÇÃO
# Copie para .env e preencha com os valores reais.
# NUNCA coloque credenciais reais neste arquivo — ele vai para o Git.
# ==========================================

# ==========================================
# SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# AUTENTICAÇÃO JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção o servidor não sobe sem esta variável definida.
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ==========================================
# SQL SERVER / AZURE SQL
# ==========================================
DB_USER=
DB_PASSWORD=
DB_SERVER=seu-servidor.database.windows.net
DB_DATABASE=

# ==========================================
# AZURE BLOB STORAGE
# ==========================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=justificativas

# ==========================================
# API SECULLUM
# Conta de serviço usada pelo backend (monitor de equipamentos).
# O login dos usuários usa as credenciais deles, não estas.
# ==========================================
SECULLUM_API_URL=https://pontowebintegracaoexterna.secullum.com.br
SECULLUM_AUTH_URL=https://autenticador.secullum.com.br/Token
SECULLUM_USERNAME=
SECULLUM_PASSWORD=
SECULLUM_CLIENT_ID=3

# ==========================================
# AZURE COMPUTER VISION (OCR)
# ==========================================
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
